{
  "compilerOptions": {
    "target": "ES2020",
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "jsx": "react-jsx",
    "moduleResolution": "bundler",
    "baseUrl": ".",
    "paths": { "@/*": ["./src/*"], "@worker/*": ["./worker/src/*"] },
    "strict": false,
    // better-auth 1.7 client types collapse `useSession().data` to `never`
    // without it; the frontend already passes with it on.
    "strictNullChecks": true,
    "skipLibCheck": true,
    "allowImportingTsExtensions": true,
    "noEmit": true
  },
  "include": ["src"]
}
